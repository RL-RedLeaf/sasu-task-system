# SASU 校园任务平台 · 环境变量模板（PRD §12.1）
# 复制为仓库根 .env 使用；缺失 JWT_SECRET / DATABASE_URL 时 api 启动直接失败。

# ---------- 应用 ----------
NODE_ENV=production
PORT=3000
# api 容器内经 compose 注入同名变量；本地开发用 mysql://root:root@localhost:3306/sasu_dev
DATABASE_URL=mysql://sasu:sasu_change_me@mysql:3306/sasu
# 至少 32 字节随机串，例如：openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-bytes-random-secret
SESSION_DAYS=7
UPLOAD_DIR=/data/uploads
PUBLIC_ORIGIN=http://localhost
TZ=Asia/Shanghai
LOG_LEVEL=info
# CI/Docker 构建时注入，用于 /healthz 展示
BUILD_TIME=

# ---------- MySQL（compose 用） ----------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=sasu
MYSQL_USER=sasu
MYSQL_PASSWORD=sasu_change_me

# ---------- SMTP（未配置则只发站内信，PRD §6.7） ----------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
