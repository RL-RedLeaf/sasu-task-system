{
  "name": "@sasu/api",
  "version": "0.0.1",
  "private": true,
  "description": "SASU 校园任务平台后端（NestJS 12 + Prisma 7）",
  "scripts": {
    "predev": "pnpm --filter @sasu/shared build",
    "dev": "prisma generate && nest start --watch",
    "build": "pnpm --filter @sasu/shared build && prisma generate && nest build",
    "prisma:generate": "prisma generate",
    "typecheck": "pnpm --filter @sasu/shared build && prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @sasu/shared build && prisma generate && jest",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "start:prod": "node dist/main.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "12.4.2",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sasu/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "node-cron": "^4.6.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@sasu/shared$": "<rootDir>/../../packages/shared/src/index.ts"
    }
  }
}
