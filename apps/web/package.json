    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
